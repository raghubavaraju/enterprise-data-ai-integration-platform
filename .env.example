# =============================================================================
# Enterprise Data & AI Integration Platform - environment template
# -----------------------------------------------------------------------------
# Copy to .env and fill in.  NEVER commit .env.
#   cp .env.example .env
#
# The platform runs in two modes:
#   PLATFORM_MODE=local  -> everything runs on your laptop, no cloud account
#   PLATFORM_MODE=cloud  -> real Snowflake + real LLM provider
# =============================================================================

PLATFORM_MODE=local
ENVIRONMENT=dev
LOG_LEVEL=INFO
LOG_FORMAT=json

# -----------------------------------------------------------------------------
# API-led layer endpoints (local docker-compose defaults)
# -----------------------------------------------------------------------------
EXPERIENCE_API_PORT=8080
STORE_EXPERIENCE_API_PORT=8093
PROCESS_API_PORT=8091
SYSTEM_API_PORT=8090
DATA_API_PORT=8092
AI_SERVICE_PORT=8087

CRM_SYSTEM_URL=http://localhost:8081
ORDER_SYSTEM_URL=http://localhost:8082
SUPPORT_SYSTEM_URL=http://localhost:8083
LOYALTY_SYSTEM_URL=http://localhost:8084
CATALOG_SYSTEM_URL=http://localhost:8085
SNOWFLAKE_DATA_API_URL=http://localhost:8092
SYSTEM_API_URL=http://localhost:8090
PROCESS_API_URL=http://localhost:8091
AI_SERVICE_URL=http://localhost:8087

# Who may open the DuckDB warehouse file directly.  Only the Snowflake SQL API
# service sets this to "direct"; every other service goes through that API.
# Ignored entirely in cloud mode.
WAREHOUSE_ACCESS=api

# -----------------------------------------------------------------------------
# OAuth 2.0 client credentials (mock authorization server in local mode)
# -----------------------------------------------------------------------------
OAUTH_TOKEN_URL=http://localhost:8080/oauth/token
OAUTH_CLIENT_ID=acme-portal-client
# Local development secret only. In cloud mode this comes from the secrets
# manager and is never present in a file.
OAUTH_CLIENT_SECRET=change-me-local-only
OAUTH_AUDIENCE=https://api.acme-retail.example.com
OAUTH_SCOPES=customer:read insights:read ai:invoke

# -----------------------------------------------------------------------------
# API policies
# -----------------------------------------------------------------------------
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RESET_SECONDS=30
DOWNSTREAM_TIMEOUT_SECONDS=10
IDEMPOTENCY_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Snowflake (cloud mode only - leave blank for local mode)
# -----------------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=SVC_MULE_INTEGRATION
SNOWFLAKE_ROLE=ACME_INTEGRATION_RW
SNOWFLAKE_WAREHOUSE=ACME_INTEGRATION_WH
SNOWFLAKE_DATABASE=ACME_EDP
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
# Path to the RSA private key used for key-pair auth. Do not commit the key.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# -----------------------------------------------------------------------------
# AI provider
#   local  -> deterministic grounded template engine (no network, no cost)
#   cortex -> Snowflake Cortex (AI_COMPLETE / EMBED_TEXT / VECTOR_COSINE_SIMILARITY)
#   openai / bedrock -> external LLM gateway
# -----------------------------------------------------------------------------
AI_PROVIDER=local
AI_MODEL=llama3.1-70b
AI_EMBEDDING_MODEL=snowflake-arctic-embed-m
AI_MAX_OUTPUT_TOKENS=600
AI_TEMPERATURE=0.1
AI_TIMEOUT_SECONDS=20
AI_PII_REDACTION=true
AI_HUMAN_REVIEW_THRESHOLD=0.60

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# -----------------------------------------------------------------------------
# Local warehouse (DuckDB stand-in for Snowflake)
# -----------------------------------------------------------------------------
LOCAL_WAREHOUSE_PATH=local_warehouse/acme_edp.duckdb

# -----------------------------------------------------------------------------
# Observability
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAMESPACE=acme-edp
CORRELATION_ID_HEADER=x-correlation-id
